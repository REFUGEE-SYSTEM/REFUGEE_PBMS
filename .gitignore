.installed.cfg
*.egg

# Odoo runtime & Filestore
/addons/
filestore/
sessions/
*.log
logs/*
!logs/.gitkeep

# Databases & Backups
*.dump
*.sql
!infrastructure/postgres/init/*.sql
*.tar.gz
database/backups/*
!database/backups/.gitkeep

