COMPOSE_PROJECT_NAME=refugee-pbms

# Host ports
PBMS_POSTGRES_PORT=5635
PBMS_REDIS_PORT=6581
PBMS_ODOO_PORT=8369
PBMS_STAFF_API_PORT=8350

# Dedicated PBMS Postgres & Redis
PBMS_DB_USER=pbmsuser
PBMS_DB_PASSWORD=__CHANGE_ME__
PBMS_ODOO_DB=pbmsdb
PBMS_BGTASK_DB=bgtaskdb

# Odoo Admin
PBMS_ODOO_ADMIN_PASSWORD=__CHANGE_ME__

# Read-only connection to Refugee-Registry Postgres (via host.docker.internal)
PBMS_SR_DB_HOST=host.docker.internal
PBMS_SR_DB_PORT=5535
PBMS_SR_DB_NAME=refugee_registry_db
PBMS_SR_DB_USER=pbms_reader
PBMS_SR_DB_PASSWORD=__CHANGE_ME__

# External Refugee-G2P-Bridge API port (via host.docker.internal)
BRIDGE_API_PORT=8395
