# ==============================================================================
# REFUGEE MANAGEMENT STANDALONE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Standalone Port Allocations (Distinct from legacy PBMS on 8069/5433/6379/8050):
#   - Odoo HTTP: 8169
#   - PostgreSQL: 5543
#   - Redis: 6389
#   - PBMS Staff Portal API: 8150
#   - OpenG2P ID Generator: 8140
#   - Keycloak (Optional SSO): 8180
#   - MinIO S3 API (Optional): 9110
#   - MinIO S3 Console: 9111
#   - G2P Bridge Partner API: 8102
#   - SPAR Mapper API: 8104
# ==============================================================================

PROJECT_NAME=refugee-management
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Dedicated standalone instance)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5543
POSTGRES_USER=refugee_user
POSTGRES_PASSWORD=refugee_pass_dev_only
POSTGRES_DB=refugee_management_db
POSTGRES_BGTASK_DB=refugee_bgtask_db

# ------------------------------------------------------------------------------
# Redis Configuration (Dedicated standalone instance)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PBMS_DB=1
REDIS_BRIDGE_DB=2

# ------------------------------------------------------------------------------
# Odoo 17 Application Configuration
# ------------------------------------------------------------------------------
ODOO_HTTP_PORT=8169
ODOO_GEVENT_PORT=8172
ODOO_ADMIN_PASSWORD=admin
ODOO_LOG_LEVEL=info
ODOO_DATA_DIR=./filestore

# ------------------------------------------------------------------------------
# PBMS Staff Portal API Configuration
# ------------------------------------------------------------------------------
PBMS_STAFF_API_HOST=0.0.0.0
PBMS_STAFF_API_PORT=8150
PBMS_STAFF_API_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# Identity & Service Integration (Standalone / Optional)
# ------------------------------------------------------------------------------
KEYCLOAK_ENABLED=false
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=refugee-staff

ID_GENERATOR_ENABLED=false
ID_GENERATOR_PORT=8140

MINIO_ENABLED=false
MINIO_API_PORT=9110
MINIO_CONSOLE_PORT=9111
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword

# ------------------------------------------------------------------------------
# Payment Integration: G2P Bridge & SPAR (Optional / Staged)
# ------------------------------------------------------------------------------
G2P_BRIDGE_ENABLED=false
G2P_BRIDGE_API_PORT=8102
G2P_BRIDGE_EXAMPLE_BANK_PORT=8103

SPAR_ENABLED=false
SPAR_MAPPER_API_PORT=8104
SPAR_BENE_API_PORT=8105
