<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_priority_rule_definition_form_inherit" model="ir.ui.view">
        <field name="name">g2p.priority.rule.definition.form.inherit</field>
        <field name="model">g2p.priority.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_priority_rule_definition_form"/>
        <field name="arch" type="xml">

            <!-- Inject domain widgets inside the <group> -->
            <xpath expr="//form/sheet/group" position="inside">

                <!-- Domain widget for the unified 'refugee' type -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.refugee', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'refugee'"/>

                <!-- Domain widget for the 'farmer' type (legacy) -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.farmer', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'farmer'"/>

                <!-- Domain widget for the 'household' type (legacy) -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.households', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'households'"/>

                <!-- Domain widget for the 'refugee_individual' type (legacy) -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.refugee_individual', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'refugee_individual'"/>

                <!-- Domain widget for the 'refugee_group' type (legacy) -->
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.refugee_group', 'allowed_fields': ['priority_rank']}"
                       invisible="target_registry != 'refugee_group'"/>

            </xpath>
        </field>
    </record>
</odoo>
