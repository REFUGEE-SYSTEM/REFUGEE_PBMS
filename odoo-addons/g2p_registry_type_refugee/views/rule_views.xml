<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_eligibility_rule_definition_form_refugee" model="ir.ui.view">
        <field name="name">g2p.eligibility.rule.definition.form.refugee</field>
        <field name="model">g2p.eligibility.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_eligibility_rule_definition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.refugees'}"
                       invisible="target_registry != 'refugees'"/>
            </xpath>
        </field>
    </record>

    <record id="view_g2p_entitlement_rule_definition_form_refugee" model="ir.ui.view">
        <field name="name">g2p.entitlement.rule.definition.form.refugee</field>
        <field name="model">g2p.entitlement.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_entitlement_rule_definition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.refugees'}"
                       invisible="target_registry != 'refugees'"/>
            </xpath>
        </field>
    </record>

    <record id="view_g2p_priority_rule_definition_form_refugee" model="ir.ui.view">
        <field name="name">g2p.priority.rule.definition.form.refugee</field>
        <field name="model">g2p.priority.rule.definition</field>
        <field name="inherit_id" ref="g2p_pbms.view_g2p_priority_rule_definition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="pbms_domain" widget="domain"
                       options="{'model': 'g2p.register.refugees'}"
                       invisible="target_registry != 'refugees'"/>
            </xpath>
        </field>
    </record>

    <record id="view_g2p_eligibility_summary_wizard_form_inherit_beneficiaries_refugee" model="ir.ui.view">
        <field name="name">g2p.bgtask.summary.wizard.form.inherit.beneficiaries.refugee</field>
        <field name="model">g2p.bgtask.summary.wizard</field>
        <field name="inherit_id" ref="g2p_registry_addon.view_g2p_eligibility_summary_wizard_form_inherit_beneficiaries"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='beneficiary_search_household']" position="after">
                <group name="beneficiary_search_refugees" invisible="target_registry != 'refugees'">
                    <widget name="g2p_beneficiaries_widget" model="g2p.register.refugees" id="refugee_beneficiary_search_widget"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
